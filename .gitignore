# Nix64 never carries C64 ROMs, commercial software or machine images.
# Bring your own; these patterns keep them out of git by accident.
*.d64
*.d71
*.d81
*.g64
*.g71
*.x64
*.t64
*.tap
*.crt
*.vsf
*.rom
*.sid
/roms/
/disks/
/shelf/
# The library is YOUR folder of disks and ROMs (default ~/c64-library, outside the repo). If one is ever
# made inside a checkout, none of it can be committed.
/c64-library/
**/c64-library/
library.json
# VICE source tree and tarballs fetched for the proof steps in the README
/vice-*/
/vice-*.tar.gz
# telemetry shared-memory files and local scratch
*.shm
*.log
node_modules/
